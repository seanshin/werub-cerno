# Cerno 환경변수 — 값은 .env 에만(gitignore). 하드코딩 금지.

# ── 공개 주소 ────────────────────────────────────────────────
CERNO_PUBLIC_BASE=https://cerno.example.org

# ── HIS SMART on FHIR (EHR launch) ──────────────────────────
# HIS smart-client 모듈로 발급. redirectUris = {CERNO_PUBLIC_BASE}/smart/callback
CERNO_SMART_CLIENT_ID=cerno-weve-smart
CERNO_SMART_CLIENT_SECRET=          # confidential client. 서버 전용
# 신뢰 issuer 화이트리스트(쉼표 구분) — 미설정 시 client_secret SSRF 위험
CERNO_SMART_ISS_ALLOW=his.example.org
CERNO_SMART_DEFAULT_ISS=https://his.example.org   # standalone launch(포털 진입) 기본 issuer
CERNO_FHIR_BASE=https://his.example.org/fhir/R4
# 읽기 전용 9종. Cerno는 write-back 하지 않는다.
CERNO_SMART_SCOPE="launch openid fhirUser patient/Patient.read patient/Condition.read patient/Observation.read patient/DiagnosticReport.read patient/Procedure.read patient/MedicationRequest.read patient/AllergyIntolerance.read patient/DocumentReference.read"

# ── 세션·신원 서명 ───────────────────────────────────────────
CERNO_SESSION_SECRET=               # 세션 쿠키 HMAC. 랜덤 32B+
CERNO_SESSION_TTL=28800             # 8h. per-user SMART 토큰 TTL과 정합 확인

# ── 내부 통신 (web → api) ────────────────────────────────────
CERNO_API_INTERNAL=http://cerno-api:8300
CERNO_API_KEY=                      # 신원 헤더 HMAC 서명 키 겸용

# ── AI 서버 (WeRU.B) ─────────────────────────────────────────
CERNO_AI_BASE=https://example.org/ollama
CERNO_AI_KEY=                       # ⚠️ 만료 관리 — 발급 시 D-7 경보 등록
# 기본 채팅 모델 공유(확정) — 전용 베이스는 16GB에 자리 없음(02_Phase0 §5).
# 추가 VRAM 0 · appServer 트래픽으로 업무시간 상시 웜 · KorMedMCQA 67.5%.
CERNO_AI_MODEL=qwen2.5:14b
CERNO_AI_EMBED_MODEL=bge-m3
# 🔴 필수 — 미명시 시 bge-m3 가 1.16GB 가 아니라 4.5GB 를 잡아 예산이 무너진다.
CERNO_AI_EMBED_NUM_CTX=2048
CERNO_AI_KEEP_ALIVE=5m              # 서버 env 기본값과 정합. 워밍은 유휴시간대 안전망
CERNO_AI_TEMPERATURE=0.2
CERNO_AI_SEED=42                    # 재현성. 변경 시 성능 기준선 재산출
CERNO_AI_NUM_PREDICT=800

# ── per-user SMART 토큰 저장소 ───────────────────────────────
# 🔴 인증 필수 — 살아있는 HIS access_token 이 여기 저장된다.
# compose 가 ${VAR:?} 로 강제하므로 미설정 시 아예 뜨지 않는다.
CERNO_REDIS_PASSWORD=
CERNO_REDIS_URL=redis://:CHANGEME@cerno-redis:6379/0   # 위 비밀번호와 일치시킬 것

# ── 의료진별 AI 키 (회신 A-1) ────────────────────────────────
# 공정 큐 버킷이 API 키의 sha256 이라 단일 키면 의료진 수와 무관하게 동시 1건이 된다.
# {"<Practitioner id>":"sk-...","...":"sk-..."} 형태. 운영에서는 시크릿 매니저로.
CERNO_AI_KEYS=""

# ── FHIR ─────────────────────────────────────────────────────
CERNO_FHIR_TIMEOUT=10
CERNO_DB_PATH=cerno.db
CERNO_CONFIG_DIR=config

# ── 근거 게이트 ──────────────────────────────────────────────
# AI 서버 의료법령 코퍼스 기준선 0.45. Phase 2-6에서 Cerno 코퍼스로 재실측.
CERNO_CONFIDENCE_MIN=0.45
CERNO_MIN_EVIDENCE=1
